    {
      "source": "/About.dc.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/calculators",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/knowledge",
      "destination": "/Knowledge.dc.html"
    },
    {
      "source": "/updates",
      "destination": "/Updates.dc.html"
    },
    {
      "source": "/about",
      "destination": "/About.dc.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/paygw-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/gst-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/fbt-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/income-tax-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/super-guarantee-calculator",
