{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.taxsignal.com.au"
        }
      ],
      "destination": "https://taxsignal.com.au/:path*",
      "permanent": true
    },
    {
      "source": "/TaxSignal%20Landing.dc.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Calculators.dc.html",
      "destination": "/calculators",
      "permanent": true
    },
    {
      "source": "/Knowledge.dc.html",
      "destination": "/knowledge",
      "permanent": true
    },
    {
      "source": "/Updates.dc.html",
      "destination": "/updates",
      "permanent": true
    },
    {
      "source": "/About.dc.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/KeyDates.dc.html",
      "destination": "/key-dates",
      "permanent": true
    },
    {
      "source": "/underpaid.html",
      "destination": "/am-i-being-underpaid",
      "permanent": true
    },
    {
      "source": "/underpaid",
      "destination": "/am-i-being-underpaid",
      "permanent": true
    },
    {
      "source": "/tools.html",
      "destination": "/tools",
      "permanent": true
    },
    {
      "source": "/invoice.html",
      "destination": "/invoice-maker",
      "permanent": true
    },
    {
      "source": "/invoice",
      "destination": "/invoice-maker",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/invoice-maker",
      "destination": "/invoice.html"
    },
    {
      "source": "/am-i-being-underpaid",
      "destination": "/underpaid.html"
    },
    {
      "source": "/calculators",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/knowledge",
      "destination": "/Knowledge.dc.html"
    },
    {
      "source": "/updates",
      "destination": "/Updates.dc.html"
    },
    {
      "source": "/about",
      "destination": "/About.dc.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/key-dates",
      "destination": "/KeyDates.dc.html"
    },
    {
      "source": "/paygw-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/gst-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/fbt-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/income-tax-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/super-guarantee-calculator",
      "destination": "/Calculators.dc.html"
    },
    {
      "source": "/capital-gains-tax-calculator",
      "destination": "/Calculators.dc.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|icon-192.png|icon-512.png|og-image.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/data/awards/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}